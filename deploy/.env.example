# Copy to .env (in this folder) and fill in. .env is not committed.

# ---- with a domain (the normal case) -----------------------------------------------
# The domain must already point at this server (an A record with its IP), or the HTTPS
# certificate cannot be issued.
SITE_ADDRESS=autoline.example.com
PUBLIC_ORIGIN=https://autoline.example.com

# ---- without a domain, for a first test on the IP address only ----------------------
# Plain http: the connection is not encrypted, so use it to check that things work and
# not for real accounts. Replace the two lines above with:
# SITE_ADDRESS=:80
# PUBLIC_ORIGIN=http://203.0.113.10

# Where the data and the backups live on the server. Both folders must belong to uid
# 1000 - see the guide.
DATA_PATH=/srv/autoline/data
BACKUP_PATH=/srv/autoline/backups

# How many verified backups to keep.
BACKUP_KEEP=3

# The first administrator, created only on an empty installation. Its password is
# generated and printed once in the log: docker compose logs backend
ADMIN_USERNAME=admin

# Optional. The vehicle catalog's photos come from Wikipedia, which allows 200 requests a
# minute to a client that names a contact (the site's address or an email) and 10 to one
# that does not.
CATALOG_PHOTO_CONTACT=
