# Copy to .env (in this folder) and fill in. .env is not committed.

# The address in the browser, exactly - it must match the name in autoline.caddy.
PUBLIC_ORIGIN=https://autoline.2.24.60.139.sslip.io

DATA_PATH=/srv/autoline/data
BACKUP_PATH=/srv/autoline/backups
BACKUP_KEEP=3

# Memory is capped; the processor is weighted. Every other container has 1024 shares,
# so 4096 puts this site first when both want the CPU, and either may use all of it
# while the other is idle.
BACKEND_MEMORY=4g
BACKEND_CPU_SHARES=4096

ADMIN_USERNAME=admin
CATALOG_PHOTO_CONTACT=
